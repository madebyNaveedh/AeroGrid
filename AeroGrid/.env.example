# ==============================================================================
# AeroGrid Environment Configuration
# ==============================================================================

# LLM API Credentials (Standard OpenAI-compatible API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# AeroGrid Operational Settings
AEROGRID_ENV=development
AEROGRID_DB_PATH=backend/audit/aerogrid_audit.db
AEROGRID_PARQUET_DIR=backend/audit/exports
AEROGRID_LOG_LEVEL=INFO

# Simulation & Execution Mode
# Set to 'true' to use deterministic domain reasoning without consuming LLM credits.
# Set to 'false' to route state evaluations to live LLM endpoints.
MOCK_LLM_MODE=false

